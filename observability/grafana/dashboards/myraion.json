      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "decimals": 0 } },
      "targets": [{ "expr": "sum(myraion_chat_soobshenie_oshibka_total)", "legendFormat": "Ошибки", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 23,
      "type": "stat",
      "title": "История открыта",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 14 },
      "fieldConfig": { "defaults": { "decimals": 0 } },
      "targets": [{ "expr": "sum(myraion_chat_istoriya_uspeh_total)", "legendFormat": "История", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
