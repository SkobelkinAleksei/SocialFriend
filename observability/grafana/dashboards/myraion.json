      "targets": [
        { "expr": "sum(increase(myraion_outbox_zapisano_total[2m]))", "legendFormat": "Outbox записан", "refId": "A" },
        { "expr": "sum(increase(myraion_outbox_otpravleno_total[2m]))", "legendFormat": "Ушло в Kafka", "refId": "B" },
        { "expr": "sum(increase(myraion_outbox_oshibka_total[2m]))", "legendFormat": "Ошибка outbox", "refId": "C" },
        { "expr": "sum(increase(myraion_dzhob_uspeh_total[2m]))", "legendFormat": "Задача выполнена", "refId": "D" },
        { "expr": "sum(increase(myraion_dzhob_oshibka_total[2m]))", "legendFormat": "Задача упала", "refId": "E" }
      ]
