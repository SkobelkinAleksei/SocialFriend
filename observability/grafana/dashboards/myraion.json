      "fieldConfig": { "defaults": { "decimals": 0, "custom": { "drawStyle": "bars", "fillOpacity": 40 } } },
      "targets": [
        { "expr": "sum by (klass) (increase(myraion_shlyuz_oshibka_total[2m]))", "legendFormat": "{{klass}}", "refId": "A" }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Медленные запросы и время ответа шлюза",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 53 },
