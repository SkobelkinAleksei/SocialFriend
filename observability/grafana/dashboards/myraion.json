        { "expr": "sum(increase(myraion_chat_soobshenie_lichnoe_total[2m]))", "legendFormat": "Личные", "refId": "A" },
        { "expr": "sum(increase(myraion_chat_soobshenie_gruppa_total[2m]))", "legendFormat": "Групповые", "refId": "B" },
        { "expr": "sum(increase(myraion_chat_soobshenie_oshibka_total[2m]))", "legendFormat": "Не отправились", "refId": "C" }
