    {
      "id": 19,
      "type": "timeseries",
      "title": "Сервисы на связи (1 = работает)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 61 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1 } },
      "targets": [
        { "expr": "up", "legendFormat": "{{prilozhenie}}", "refId": "A" }
