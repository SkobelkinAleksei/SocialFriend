{
  "uid": "myraion-overview",
  "title": "На районе — обзор",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "tags": ["myraion"],
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Вход и регистрация — крупные цифры: сколько раз с запуска сервиса",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Успешные входы",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "none" } },
      "targets": [{ "expr": "sum(myraion_vhod_uspeh_total)", "legendFormat": "Входы", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Неудачные входы",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "none" } },
      "targets": [{ "expr": "sum(myraion_vhod_oshibka_total)", "legendFormat": "Ошибки входа", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Блокировки аккаунта",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "none" } },
      "targets": [{ "expr": "sum(myraion_vhod_blokirovka_total)", "legendFormat": "Блокировки", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Новые регистрации",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "none" } },
      "targets": [{ "expr": "sum(myraion_registraciya_uspeh_total)", "legendFormat": "Регистрации", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Когда это случилось (столбик ≈ 1 событие)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "none", "custom": { "drawStyle": "bars", "fillOpacity": 40, "barAlignment": 0 } } },
      "targets": [
        { "expr": "sum(increase(myraion_vhod_uspeh_total[2m]))", "legendFormat": "Успешный вход", "refId": "A" },
        { "expr": "sum(increase(myraion_vhod_oshibka_total[2m]))", "legendFormat": "Неудачный вход", "refId": "B" },
        { "expr": "sum(increase(myraion_registraciya_uspeh_total[2m]))", "legendFormat": "Регистрация", "refId": "C" },
        { "expr": "sum(increase(myraion_registraciya_oshibka_total[2m]))", "legendFormat": "Ошибка регистрации", "refId": "D" }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Чаты",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 }
    },
