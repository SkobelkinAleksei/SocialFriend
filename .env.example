# Скопируйте в .env на сервере и заполните. Этот файл — образец, в git его можно держать.
# Локально на ПК файл не обязателен: в yaml и docker-compose уже стоят localhost-дефолты.

# Папка фронта MyRaion (для docker compose build frontend)
# На ПК: путь ниже. На сервере после git clone: FRONTEND_DIR=./frontend
FRONTEND_DIR=C:/Users/Магамед/Desktop/MyRaion

# Postgres внутри Docker (это НЕ ваш локальный Postgres на 5432 — его не трогаем)
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password

# JWT: один и тот же секрет у security и gateway. На сервере — случайная строка ≥64 символов.
JWT_SECRET=your-very-strong-secret-key-32-characters-long

# Внутренние вызовы сервисов друг к другу
INTERNAL_API_KEY=local-internal-api-key-change-in-prod

# Подсказки адресов (DaData). Без ключа подсказки адресов при регистрации не сработают.
DADATA_API_KEY=

# Сайт. В Docker фронт на :80, API через Nginx на том же хосте.
APP_CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://localhost:5173,http://localhost:5174,http://localhost:5175

# Локально: id соседской учётки НЕ указывайте. Отдельный аккаунт админа, после рестарта user.
# APP_ADMIN_USER_IDS=1
# APP_ADMIN_EMAILS=admin@example.com

# Почта (подтверждение регистрации и «забыли пароль»). Для inbox.ru / mail.ru:
# MAIL_HOST=smtp.mail.ru
# MAIL_PORT=465
# MAIL_SMTP_SSL=true
# MAIL_USERNAME=ящик@inbox.ru
# MAIL_PASSWORD=пароль_приложения_из_настроек_почты
# MAIL_FROM=ящик@inbox.ru
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

