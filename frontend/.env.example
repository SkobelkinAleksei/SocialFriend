# Скопируйте в .env рядом с этим файлом, если деплоите фронт не через Docker Nginx.
# Для разработки на ПК (`npm run dev`) файл не обязателен.
# В Docker production-сборке VITE_API_URL пустой: браузер ходит на тот же хост, Nginx проксирует на gateway.

# VITE_API_URL=http://localhost:8080
# VITE_WS_URL=ws://localhost:8080
